---
import Main from '../layouts/main.astro';
import { Button } from "@/components/ui/button";
import Icon from "../components/Icon.astro";
export const prerender = true;
const siteName = import.meta.env.SITE_NAME;
---

<Main title={`${siteName} - 科技创新的引领者`}>
	<main>
		<!-- Hero Section -->
		<section class="py-20 bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-gray-900 dark:to-blue-900/20">
			<div class="container mx-auto px-4">
				<div class="flex flex-col md:flex-row items-center">
					<div class="md:w-1/2 mb-10 md:mb-0">
						<h1 class="text-4xl md:text-5xl font-bold mb-6">
							<span>一站式企业</span>
							<span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600">智能解决方案</span>
						</h1>
						<p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-lg">
							简单、高效且经济实惠！整合人工智能、数据分析和专业服务，助力企业数字化转型。
						</p>
						<div class="flex gap-4">
							<Button variant="default" size="lg" className="bg-blue-600 hover:bg-blue-700">免费试用</Button>
							<Button variant="outline" size="lg" className="hover:bg-gray-100">预约演示</Button>
						</div>
					</div>
					<div class="md:w-1/2">
						<div class="relative">
							<div class="absolute -top-6 -left-6 w-64 h-64 bg-blue-200 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob"></div>
							<div class="absolute -bottom-8 -right-8 w-64 h-64 bg-purple-200 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob animation-delay-2000"></div>

							<!-- 替换图片为SVG图形 -->
							<div class="relative bg-white dark:bg-gray-800 p-8 rounded-lg shadow-lg">
								<div class="dashboard-svg">
									<img src="/images/dashboard.svg" alt="Dashboard" class="w-full h-auto" />
								</div>

								<!-- 数据指标 -->
								<div class="mt-4 grid grid-cols-2 gap-4">
									<div class="bg-blue-50 dark:bg-blue-900/20 p-3 rounded-md">
										<p class="text-sm font-medium text-blue-700 dark:text-blue-300">数据分析</p>
										<p class="text-2xl font-bold">实时</p>
									</div>
									<div class="bg-purple-50 dark:bg-purple-900/20 p-3 rounded-md">
										<p class="text-sm font-medium text-purple-700 dark:text-purple-300">AI驱动</p>
										<p class="text-2xl font-bold">智能</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- App Icons Section -->
		<section class="py-16 bg-white dark:bg-gray-900">
			<div class="container mx-auto px-4 text-center">
				<div class="flex flex-wrap justify-center gap-8 md:gap-12">
					{[
						{ name: "AI分析", icon: "🧠" },
						{ name: "AI与精神分析", icon: "🔍" },
						{ name: "股票分析", icon: "📈" },
						{ name: "PDF工具", icon: "📄" },
						{ name: "数据可视化", icon: "📊" },
						{ name: "企业咨询", icon: "💼" }
					].map(app => (
						<div class="flex flex-col items-center">
							<div class="w-16 h-16 flex items-center justify-center text-3xl bg-gray-100 dark:bg-gray-800 rounded-full mb-3">{app.icon}</div>
							<span class="text-sm font-medium">{app.name}</span>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Features Section -->
		<section class="py-20 bg-gray-50 dark:bg-gray-800">
			<div class="container mx-auto px-4">
				<h2 class="text-3xl font-bold text-center mb-16">一体化解决方案</h2>
				<div class="grid md:grid-cols-3 gap-8">
					{[
						{
							title: "人工智能",
							desc: "提供先进的AI解决方案，包括机器学习、深度学习和自然语言处理",
							icon: "🤖"
						},
						{
							title: "AI与精神分析",
							desc: "AI赋能的精神分析工具，结合荣格心理学与现代技术，提供深度人格洞察",
							icon: "🧠"
						},
						{
							title: "技术咨询",
							desc: "为企业提供专业的技术咨询服务，助力数字化转型",
							icon: "💡"
						}
					].map(feature => (
						<div class="bg-white dark:bg-gray-900 p-8 rounded-lg shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col">
							<div class="text-4xl mb-4">{feature.icon}</div>
							<h3 class="text-xl font-semibold mb-4">{feature.title}</h3>
							<p class="text-gray-600 dark:text-gray-300 mb-6">{feature.desc}</p>
							<a href="#" class="text-blue-600 dark:text-blue-400 mt-auto inline-flex items-center">
								了解更多
								<Icon name="arrow-right" class="w-4 h-4 ml-1" />
							</a>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 股票分析产品介绍 -->
		<section class="py-20 bg-white dark:bg-gray-900">
			<div class="container mx-auto px-4">
				<div class="flex flex-col md:flex-row items-center gap-12">
					<div class="md:w-1/2">
						<h2 class="text-3xl font-bold mb-6">
							<span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600">
								智能股票趋势分析
							</span>
			</h2>
						<p class="text-gray-600 dark:text-gray-300 mb-6">
							我们的AI驱动股票分析系统能够帮助投资者做出更明智的决策。通过深度学习和大数据分析，预测市场趋势，识别投资机会。
						</p>
						<ul class="space-y-4 mb-8">
							<li class="flex items-start">
								<div class="flex-shrink-0 w-6 h-6 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center mt-1">
									<Icon name="checkmark" class="w-4 h-4 text-blue-600 dark:text-blue-400" />
								</div>
								<div class="ml-3">
									<h4 class="font-medium">智能趋势预测与分析</h4>
									<p class="text-gray-600 dark:text-gray-400 text-sm">利用机器学习算法分析历史数据和市场情绪，预测股票未来走势</p>
								</div>
							</li>
							<li class="flex items-start">
								<div class="flex-shrink-0 w-6 h-6 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center mt-1">
									<Icon name="checkmark" class="w-4 h-4 text-blue-600 dark:text-blue-400" />
								</div>
								<div class="ml-3">
									<h4 class="font-medium">个性化投资组合建议</h4>
									<p class="text-gray-600 dark:text-gray-400 text-sm">根据用户风险偏好和投资目标，自动筛选符合条件的优质股票</p>
								</div>
							</li>
							<li class="flex items-start">
								<div class="flex-shrink-0 w-6 h-6 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center mt-1">
									<Icon name="checkmark" class="w-4 h-4 text-blue-600 dark:text-blue-400" />
								</div>
								<div class="ml-3">
									<h4 class="font-medium">实时风险评估与预警</h4>
									<p class="text-gray-600 dark:text-gray-400 text-sm">全面评估投资组合风险，提供风险预警和资产配置建议</p>
								</div>
							</li>
						</ul>
						<div class="flex gap-4">
							<a href="/stock">
								<Button variant="default" className="bg-blue-600 hover:bg-blue-700">了解更多</Button>
							</a>
							<Button variant="outline" className="hover:bg-gray-100">免费试用</Button>
						</div>
					</div>
					<div class="md:w-1/2">
						<div class="bg-gray-50 dark:bg-gray-800 p-8 rounded-lg shadow-lg">
							<div class="aspect-video bg-white dark:bg-gray-900 rounded-md flex items-center justify-center mb-6">
								<img src="/images/icons/chart.svg" alt="Chart" class="w-24 h-24 text-blue-500 opacity-80 chart-icon" />
							</div>
							<div class="grid grid-cols-2 gap-4">
								<div class="bg-white dark:bg-gray-900 p-4 rounded-md">
									<p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">预测准确率</p>
									<p class="text-3xl font-bold text-blue-600 dark:text-blue-400">85%</p>
								</div>
								<div class="bg-white dark:bg-gray-900 p-4 rounded-md">
									<p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">用户收益提升</p>
									<p class="text-3xl font-bold text-purple-600 dark:text-purple-400">32%</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Testimonials -->
		<section class="py-20 bg-gray-50 dark:bg-gray-800">
			<div class="container mx-auto px-4">
				<h2 class="text-3xl font-bold text-center mb-16">客户评价</h2>
				<div class="grid md:grid-cols-3 gap-8">
					{[
						{
							quote: "秦项科技的AI分析工具帮助我们提高了30%的决策效率，真正实现了数据驱动的管理。",
							author: "张总",
							company: "某科技公司 CEO"
						},
						{
							quote: "股票趋势分析系统的预测准确率令人惊讶，已经成为我投资决策的重要参考。",
							author: "李先生",
							company: "资深投资者"
						},
						{
							quote: "PDF工具套件极大地提高了我们的文档处理效率，简单易用且功能强大。",
							author: "王经理",
							company: "某事务所负责人"
						}
					].map(testimonial => (
						<div class="bg-white dark:bg-gray-900 p-8 rounded-lg shadow-sm">
							<Icon name="quote" class="w-10 h-10 text-blue-200 dark:text-blue-800 mb-4" />
							<p class="text-gray-600 dark:text-gray-300 mb-6">{testimonial.quote}</p>
							<div>
								<p class="font-medium">{testimonial.author}</p>
								<p class="text-sm text-gray-500 dark:text-gray-400">{testimonial.company}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="py-20 bg-blue-600 dark:bg-blue-800">
			<div class="container mx-auto px-4 text-center">
				<h2 class="text-3xl font-bold text-white mb-6">准备好开始了吗？</h2>
				<p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
					立即体验我们的智能解决方案，提升您的业务效率和决策能力。
				</p>
				<div class="flex justify-center gap-4">
					<Button variant="default" size="lg" className="bg-white text-blue-600 hover:bg-gray-100">免费试用</Button>
					<Button variant="outline" size="lg" className="border-2 border-white text-white bg-transparent hover:bg-white/20">联系销售</Button>
				</div>
		</div>
		</section>
	</main>
</Main>

<style>
	@keyframes blob {
		0% { transform: scale(1); }
		33% { transform: scale(1.1); }
		66% { transform: scale(0.9); }
		100% { transform: scale(1); }
	}
	.animate-blob {
		animation: blob 7s infinite;
	}
	.animation-delay-2000 {
		animation-delay: 2s;
	}

	/* 添加脉冲动画 */
	@keyframes pulse {
		0% { opacity: 0.6; r: 8; }
		50% { opacity: 1; r: 10; }
		100% { opacity: 0.6; r: 8; }
	}
	.pulse-circle {
		animation: pulse 2s infinite;
	}

	/* 添加仪表板悬停效果 */
	.dashboard-svg {
		transition: transform 0.3s ease;
	}
	.dashboard-svg:hover {
		transform: translateY(-5px);
	}

	/* 深色模式下的图标处理 */
	@media (prefers-color-scheme: dark) {
		.chart-icon {
			filter: invert(1);
		}
	}
</style>
