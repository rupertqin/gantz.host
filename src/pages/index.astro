---
import Main from '../layouts/main.astro';
import { Button } from "@/components/ui/button";
export const prerender = true;
const siteName = import.meta.env.SITE_NAME;
---

<Main title="${siteName} - 科技创新的引领者">
	<!-- 简化的背景装饰 -->
	<div class="absolute inset-0 -z-10">
		<div class="absolute top-0 right-0 w-72 h-72 bg-blue-100/40 rounded-bl-full"></div>
		<div class="absolute bottom-0 left-0 w-72 h-72 bg-purple-100/40 rounded-tr-full"></div>
	</div>

	<main class="container mx-auto px-4 relative">
		<!-- Hero Section -->
		<section class="py-20 text-center">
			<div class="mb-8">
				<h1 class="text-6xl font-bold mb-4">
					<span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-blue-600">秦项</span>
					<span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600">科技</span>
				</h1>
				<p class="text-2xl font-semibold text-gray-700 dark:text-gray-200">让科技创造更多可能</p>
			</div>
			<p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
				专注于人工智能、大数据分析和科技创新，为企业提供智能化解决方案
			</p>
			<div class="flex justify-center gap-4">
				<Button variant="default" size="lg">了解更多</Button>
				<Button variant="outline" size="lg">联系我们</Button>
			</div>
		</section>

		<!-- Features Section -->
		<section class="py-16">
			<div class="grid md:grid-cols-3 gap-8">
				{[
					{
						title: "人工智能",
						desc: "提供先进的AI解决方案，包括机器学习、深度学习和自然语言处理"
					},
					{
						title: "MBTI分析",
						desc: "结合易经与现代心理学，提供独特的性格分析工具"
					},
					{
						title: "技术咨询",
						desc: "为企业提供专业的技术咨询服务，助力数字化转型"
					}
				].map(feature => (
					<div class="p-6 rounded-lg bg-white dark:bg-gray-800 shadow-md hover:shadow-lg transition-shadow duration-300">
						<h3 class="text-xl font-semibold mb-4">{feature.title}</h3>
						<p class="text-gray-600 dark:text-gray-300">{feature.desc}</p>
					</div>
				))}
			</div>
		</section>

		<!-- Latest News Section -->
		<section class="py-16">
			<h2 class="text-3xl font-bold mb-8 text-center">最新动态</h2>
			<div class="grid md:grid-cols-2 gap-8">
				<article class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300">
					<div class="p-6">
						<h3 class="text-xl font-semibold mb-2">新一代AI模型发布</h3>
						<p class="text-gray-600 dark:text-gray-300">
							我们最新发布的AI模型在准确性和效率方面都有显著提升...
						</p>
						<a href="#" class="text-blue-600 dark:text-blue-400 mt-4 inline-block">阅读更多 →</a>
					</div>
				</article>
				<article class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300">
					<div class="p-6">
						<h3 class="text-xl font-semibold mb-2">企业数字化转型案例</h3>
						<p class="text-gray-600 dark:text-gray-300">
							成功帮助多家企业完成数字化转型，提升运营效率...
						</p>
						<a href="#" class="text-blue-600 dark:text-blue-400 mt-4 inline-block">阅读更多 →</a>
					</div>
				</article>
			</div>
		</section>
	</main>
</Main>

<style>
	/* 添加渐变动画 */
	@keyframes gradient-shift {
		0% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
		100% { background-position: 0% 50%; }
	}

	.gradient-animate {
		background-size: 200% 200%;
		animation: gradient-shift 15s ease infinite;
	}
</style>
