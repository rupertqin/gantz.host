---
import Main from '../layouts/main.astro';
import { Button } from "@/components/ui/button";
export const prerender = true;
const siteName = import.meta.env.SITE_NAME;
---

<Main title="${siteName} - 科技创新的引领者">
	<!-- 简化的背景装饰 -->
	<div class="absolute inset-0 -z-10">
		<div class="absolute top-0 right-0 w-72 h-72 bg-blue-100/40 rounded-bl-full"></div>
		<div class="absolute bottom-0 left-0 w-72 h-72 bg-purple-100/40 rounded-tr-full"></div>
	</div>

	<main class="container mx-auto px-4 relative">
		<!-- Hero Section -->
		<section class="py-20 text-center">
			<div class="mb-8">
				<h1 class="text-6xl font-bold mb-4">
					<span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-blue-600">秦项</span>
					<span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600">科技</span>
				</h1>
				<p class="text-2xl font-semibold text-gray-700 dark:text-gray-200">让科技创造更多可能</p>
			</div>
			<p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
				专注于人工智能、大数据分析和科技创新，为企业提供智能化解决方案
			</p>
			<div class="flex justify-center gap-4">
				<Button variant="default" size="lg">了解更多</Button>
				<Button variant="outline" size="lg">联系我们</Button>
			</div>
		</section>

		<!-- Features Section -->
		<section class="py-16">
			<div class="grid md:grid-cols-3 gap-8">
				{[
					{
						title: "人工智能",
						desc: "提供先进的AI解决方案，包括机器学习、深度学习和自然语言处理"
					},
					{
						title: "AI精神分析",
						desc: "AI赋能的精神分析工具，结合荣格心理学与现代技术，提供深度人格洞察"
					},
					{
						title: "技术咨询",
						desc: "为企业提供专业的技术咨询服务，助力数字化转型"
					}
				].map(feature => (
					<div class="p-6 rounded-lg bg-white dark:bg-gray-800 shadow-md hover:shadow-lg transition-shadow duration-300">
						<h3 class="text-xl font-semibold mb-4">{feature.title}</h3>
						<p class="text-gray-600 dark:text-gray-300">{feature.desc}</p>
					</div>
				))}
			</div>
		</section>

		<!-- 新增：股票分析产品介绍 -->
		<section class="py-16 border-t border-gray-100 dark:border-gray-800">
			<div class="flex flex-col md:flex-row items-center gap-8">
				<div class="md:w-1/2">
					<h2 class="text-3xl font-bold mb-4">
						<span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-purple-600">
							智能股票趋势分析
						</span>
					</h2>
					<p class="text-gray-600 dark:text-gray-300 mb-6">
						我们的AI驱动股票分析系统能够帮助投资者做出更明智的决策。通过深度学习和大数据分析，预测市场趋势，识别投资机会。
					</p>
					<ul class="space-y-2 mb-6">
						<li class="flex items-center">
							<svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
							</svg>
							<span>智能趋势预测与分析</span>
						</li>
						<li class="flex items-center">
							<svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
							</svg>
							<span>个性化投资组合建议</span>
						</li>
						<li class="flex items-center">
							<svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
							</svg>
							<span>实时风险评估与预警</span>
						</li>
					</ul>
					<div class="flex gap-4">
						<a href="/stock">
							<Button variant="default">了解更多</Button>
						</a>
						<Button variant="outline">免费试用</Button>
					</div>
				</div>
				<div class="md:w-1/2">
					<div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg">
						<div class="aspect-video bg-gradient-to-br from-blue-100 to-purple-100 dark:from-blue-900/30 dark:to-purple-900/30 rounded-md flex items-center justify-center">
							<svg class="w-24 h-24 text-blue-500 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
							</svg>
						</div>
						<div class="mt-4 grid grid-cols-2 gap-4">
							<div class="bg-blue-50 dark:bg-blue-900/20 p-3 rounded-md">
								<p class="text-sm font-medium text-blue-700 dark:text-blue-300">预测准确率</p>
								<p class="text-2xl font-bold">85%</p>
							</div>
							<div class="bg-purple-50 dark:bg-purple-900/20 p-3 rounded-md">
								<p class="text-sm font-medium text-purple-700 dark:text-purple-300">用户收益提升</p>
								<p class="text-2xl font-bold">32%</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Latest News Section -->
		<section class="py-16">
			<h2 class="text-3xl font-bold mb-8 text-center">最新动态</h2>
			<div class="grid md:grid-cols-2 gap-8">
				<article class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300">
					<div class="p-6">
						<h3 class="text-xl font-semibold mb-2">新一代AI模型发布</h3>
						<p class="text-gray-600 dark:text-gray-300">
							我们最新发布的AI模型在准确性和效率方面都有显著提升...
						</p>
						<a href="#" class="text-blue-600 dark:text-blue-400 mt-4 inline-block">阅读更多 →</a>
					</div>
				</article>
				<article class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300">
					<div class="p-6">
						<h3 class="text-xl font-semibold mb-2">企业数字化转型案例</h3>
						<p class="text-gray-600 dark:text-gray-300">
							成功帮助多家企业完成数字化转型，提升运营效率...
						</p>
						<a href="#" class="text-blue-600 dark:text-blue-400 mt-4 inline-block">阅读更多 →</a>
					</div>
				</article>
			</div>
		</section>
	</main>
</Main>

<style>
	/* 添加渐变动画 */
	@keyframes gradient-shift {
		0% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
		100% { background-position: 0% 50%; }
	}

	.gradient-animate {
		background-size: 200% 200%;
		animation: gradient-shift 15s ease infinite;
	}
</style>
