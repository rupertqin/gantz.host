---
interface Props {
	title: string;
	description?: string;
}
import '../styles/global.css';
const siteName = import.meta.env.SITE_NAME;
const { title, description = `${siteName} - 专注于人工智能与科技创新` } = Astro.props;
const gitHash = import.meta.env.PUBLIC_GIT_HASH;
---

<html lang="zh">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title.includes(siteName) ? title : `${title} - ${siteName}`}</title>
	</head>
	<body class="min-h-screen bg-white text-gray-800 dark:bg-gray-900 dark:text-gray-200">
		<!-- 顶部导航栏 -->
		<header class="sticky top-0 z-50 bg-white dark:bg-gray-900 shadow-sm">
			<div class="container mx-auto px-4">
				<div class="flex items-center justify-between h-16">
					<div class="flex items-center">
						<a href="/" class="flex items-center">
							<img src="/images/logo.svg" alt="Logo" class="w-10 h-10 mr-2" />
							<span class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-purple-600">{siteName}</span>
						</a>
					</div>
					<!-- 桌面导航菜单 -->
					<nav class="hidden md:flex space-x-8">
						<a href="/" class="text-gray-700 hover:text-blue-600 dark:text-gray-300 dark:hover:text-blue-400 font-medium">首页</a>
						<a href="/mbti" class="text-gray-700 hover:text-blue-600 dark:text-gray-300 dark:hover:text-blue-400 font-medium">AI与精神分析</a>
						<a href="/stock" class="text-gray-700 hover:text-blue-600 dark:text-gray-300 dark:hover:text-blue-400 font-medium">股票分析</a>
						<a href="https://pdf.gantz.host/" target="_blank" class="text-gray-700 hover:text-blue-600 dark:text-gray-300 dark:hover:text-blue-400 font-medium">PDF工具</a>
						<a href="/contact" class="text-gray-700 hover:text-blue-600 dark:text-gray-300 dark:hover:text-blue-400 font-medium">联系我们</a>
					</nav>
					<div class="flex items-center">
						<!-- 免费试用按钮 -->
						<button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md font-medium hidden md:block">免费试用</button>

						<!-- 移动端菜单按钮 -->
						<button id="mobile-menu-button" class="md:hidden text-gray-700 dark:text-gray-300 p-2 focus:outline-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
							</svg>
						</button>
					</div>
				</div>

				<!-- 移动端菜单 -->
				<div id="mobile-menu" class="md:hidden hidden">
					<div class="px-2 pt-2 pb-3 space-y-1 border-t border-gray-200 dark:border-gray-700">
						<a href="/" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:text-blue-400 dark:hover:bg-gray-800">首页</a>
						<a href="/mbti" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:text-blue-400 dark:hover:bg-gray-800">AI与精神分析</a>
						<a href="/stock" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:text-blue-400 dark:hover:bg-gray-800">股票分析</a>
						<a href="https://pdf.gantz.host/" target="_blank" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:text-blue-400 dark:hover:bg-gray-800">PDF工具</a>
						<a href="/contact" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:text-blue-400 dark:hover:bg-gray-800">联系我们</a>
						<div class="mt-4 px-3">
							<button class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md font-medium">免费试用</button>
						</div>
					</div>
				</div>
			</div>
		</header>

		<slot />

		<footer class="bg-gray-100 dark:bg-gray-800 py-12 mt-16">
			<div class="container mx-auto px-4">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
					<div>
						<h3 class="text-lg font-semibold mb-4">产品</h3>
						<ul class="space-y-2">
							<li><a href="/mbti" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">AI与精神分析</a></li>
							<li><a href="/stock" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">股票趋势分析</a></li>
							<li><a href="https://pdf.gantz.host/" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">PDF工具套件</a></li>
						</ul>
					</div>
					<div>
						<h3 class="text-lg font-semibold mb-4">解决方案</h3>
						<ul class="space-y-2">
							<li><a href="#" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">企业数字化转型</a></li>
							<li><a href="#" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">人工智能应用</a></li>
							<li><a href="#" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">数据分析服务</a></li>
						</ul>
					</div>
					<div>
						<h3 class="text-lg font-semibold mb-4">资源</h3>
						<ul class="space-y-2">
							<li><a href="#" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">文档中心</a></li>
							<li><a href="#" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">API参考</a></li>
							<li><a href="#" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">常见问题</a></li>
						</ul>
					</div>
					<div>
						<h3 class="text-lg font-semibold mb-4">公司</h3>
						<ul class="space-y-2">
							<li><a href="/contact" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">联系我们</a></li>
							<li><a href="#" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">关于我们</a></li>
							<li><a href="#" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">加入我们</a></li>
						</ul>
					</div>
				</div>
				<div class="border-t border-gray-200 dark:border-gray-700 pt-8 text-center">
					<div class="flex justify-center items-center mb-4">
						<img src="/images/logo.svg" alt="Logo" class="w-10 h-10 mr-2" />
						<span class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-purple-600">{siteName}</span>
					</div>
					<p class="text-gray-600 dark:text-gray-400">&copy; {new Date().getFullYear()} {siteName} |
						<a href="https://beian.miit.gov.cn/" target="_blank" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
							桂ICP备2023011846号-1
						</a>
					</p>
					<p class="mt-1 text-xs text-gray-500 dark:text-gray-500">Build: {gitHash}</p>
				</div>
			</div>
		</footer>

		<script>
			// 移动端菜单切换
			document.addEventListener('DOMContentLoaded', () => {
				const mobileMenuButton = document.getElementById('mobile-menu-button');
				const mobileMenu = document.getElementById('mobile-menu');

				if (mobileMenuButton && mobileMenu) {
					mobileMenuButton.addEventListener('click', () => {
						mobileMenu.classList.toggle('hidden');
					});
				}
			});
		</script>
	</body>
</html>
