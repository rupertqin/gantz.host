---
import Main from '../layouts/main.astro';
import { Button } from "@/components/ui/button";
---

<Main title="股票趋势分析 - 智能选股系统">
  <main class="container mx-auto px-4 py-16">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold mb-8 text-center">
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-purple-600">智能股票趋势分析系统</span>
      </h1>

      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8 mb-12">
        <p class="text-xl text-gray-700 dark:text-gray-300 mb-6">
          基于人工智能和大数据技术，为投资者提供专业、精准的股票趋势分析和智能选股服务。
        </p>

        <div class="flex justify-center gap-4 mb-8">
          <Button variant="default" size="lg">免费体验</Button>
          <Button variant="outline" size="lg">了解更多</Button>
        </div>
      </div>

      <!-- 核心功能 -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8 text-center">核心功能</h2>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold mb-4 text-blue-600 dark:text-blue-400">趋势预测</h3>
            <p class="text-gray-600 dark:text-gray-300">
              利用先进的机器学习算法，分析历史数据和市场情绪，预测股票未来走势。
            </p>
          </div>

          <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold mb-4 text-green-600 dark:text-green-400">智能选股</h3>
            <p class="text-gray-600 dark:text-gray-300">
              根据用户风险偏好和投资目标，自动筛选符合条件的优质股票。
            </p>
          </div>

          <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold mb-4 text-purple-600 dark:text-purple-400">风险评估</h3>
            <p class="text-gray-600 dark:text-gray-300">
              全面评估投资组合风险，提供风险预警和资产配置建议。
            </p>
          </div>
        </div>
      </section>

      <!-- 技术优势 -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8 text-center">技术优势</h2>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="bg-blue-100 dark:bg-blue-900 p-3 rounded-full">
              <svg class="w-6 h-6 text-blue-600 dark:text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-2">大数据分析</h3>
              <p class="text-gray-600 dark:text-gray-300">
                每日处理超过100万条市场数据，包括价格、交易量、财报数据和市场新闻。
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="bg-green-100 dark:bg-green-900 p-3 rounded-full">
              <svg class="w-6 h-6 text-green-600 dark:text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-2">深度学习模型</h3>
              <p class="text-gray-600 dark:text-gray-300">
                采用最新的深度学习技术，不断优化预测模型，提高预测准确率。
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="bg-purple-100 dark:bg-purple-900 p-3 rounded-full">
              <svg class="w-6 h-6 text-purple-600 dark:text-purple-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-2">安全可靠</h3>
              <p class="text-gray-600 dark:text-gray-300">
                采用银行级加密技术保护用户数据，确保投资策略的安全性和私密性。
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- 价格方案 -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8 text-center">价格方案</h2>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md border border-gray-200 dark:border-gray-700">
            <h3 class="text-xl font-semibold mb-2">基础版</h3>
            <p class="text-3xl font-bold mb-4">¥99<span class="text-sm font-normal text-gray-500">/月</span></p>
            <ul class="space-y-2 mb-6">
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                每日市场分析报告
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                10只股票趋势预测
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                基础技术指标分析
              </li>
            </ul>
            <Button variant="outline" className="w-full">选择方案</Button>
          </div>

          <div class="bg-blue-50 dark:bg-blue-900/20 p-6 rounded-lg shadow-md border-2 border-blue-500 dark:border-blue-400 transform scale-105">
            <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-blue-500 text-white px-4 py-1 rounded-full text-sm font-semibold">
              最受欢迎
            </div>
            <h3 class="text-xl font-semibold mb-2">专业版</h3>
            <p class="text-3xl font-bold mb-4">¥299<span class="text-sm font-normal text-gray-500">/月</span></p>
            <ul class="space-y-2 mb-6">
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                基础版全部功能
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                50只股票趋势预测
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                个性化投资组合建议
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                风险预警系统
              </li>
            </ul>
            <Button variant="default" className="w-full">选择方案</Button>
          </div>

          <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md border border-gray-200 dark:border-gray-700">
            <h3 class="text-xl font-semibold mb-2">企业版</h3>
            <p class="text-3xl font-bold mb-4">¥999<span class="text-sm font-normal text-gray-500">/月</span></p>
            <ul class="space-y-2 mb-6">
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                专业版全部功能
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                无限股票分析
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                API接口访问
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                专属投资顾问
              </li>
            </ul>
            <Button variant="outline" className="w-full">联系我们</Button>
          </div>
        </div>
      </section>

      <!-- 联系我们 -->
      <section>
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8">
          <h2 class="text-3xl font-bold mb-6 text-center">开始使用</h2>
          <p class="text-center text-gray-600 dark:text-gray-300 mb-8">
            立即体验我们的智能股票趋势分析系统，提升您的投资决策能力
          </p>
          <div class="flex justify-center">
            <Button variant="default" size="lg">免费试用 14 天</Button>
          </div>
        </div>
      </section>
    </div>
  </main>
</Main>
