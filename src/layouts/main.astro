---
interface Props {
	title: string;
	description?: string;
}
import '../styles/global.css';
const siteName = import.meta.env.SITE_NAME;
const { title, description = `${siteName} - 专注于人工智能与科技创新` } = Astro.props;
const gitHash = import.meta.env.PUBLIC_GIT_HASH;

// 提取共用样式类
const navLinkClass = "text-gray-700 hover:text-blue-600 dark:text-gray-300 dark:hover:text-blue-400 font-medium";
const mobileNavLinkClass = "block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:text-blue-400 dark:hover:bg-gray-800";
const footerLinkClass = "text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400";
const buttonClass = "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md font-medium";
---

<html lang="zh">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title.includes(siteName) ? title : `${title} - ${siteName}`}</title>
	</head>
	<body class="min-h-screen bg-white text-gray-800 dark:bg-gray-900 dark:text-gray-200">
		<!-- 顶部导航栏 -->
		<header class="sticky top-0 z-50 bg-white dark:bg-gray-900 shadow-sm">
			<div class="container mx-auto px-4">
				<div class="flex items-center justify-between h-16">
					<div class="flex items-center">
						<a href="/" class="flex items-center">
							<img src="/images/logo.svg" alt="Logo" class="w-10 h-10 mr-2" />
							<span class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-purple-600">{siteName}</span>
						</a>
					</div>
					<!-- 桌面导航菜单 -->
					<nav class="hidden md:flex space-x-8">
						<a href="/" class={navLinkClass}>首页</a>
						<a href="/mbti" class={navLinkClass}>AI与精神分析</a>
						<a href="/stock" class={navLinkClass}>股票分析</a>
						<a href="https://pdf.gantz.host/" target="_blank" class={navLinkClass}>PDF工具</a>
						<a href="/contact" class={navLinkClass}>联系我们</a>
					</nav>
					<div class="flex items-center">
						<!-- 免费试用按钮 -->
						<button class={`${buttonClass} hidden md:block`}>免费试用</button>

						<!-- 移动端菜单按钮 -->
						<button id="mobile-menu-button" class="md:hidden text-gray-700 dark:text-gray-300 p-2 focus:outline-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
							</svg>
						</button>
					</div>
				</div>

				<!-- 移动端菜单 -->
				<div id="mobile-menu" class="md:hidden hidden fixed left-0 right-0 top-16 z-50 bg-white dark:bg-gray-900 shadow-lg">
					<div class="px-4 py-4 space-y-3 max-h-[80vh] overflow-y-auto">
						<a href="/" class={mobileNavLinkClass}>首页</a>
						<a href="/mbti" class={mobileNavLinkClass}>AI与精神分析</a>
						<a href="/stock" class={mobileNavLinkClass}>股票分析</a>
						<a href="https://pdf.gantz.host/" target="_blank" class={mobileNavLinkClass}>PDF工具</a>
						<a href="/contact" class={mobileNavLinkClass}>联系我们</a>
						<div class="mt-6 px-3">
							<button class={`w-full ${buttonClass}`}>免费试用</button>
						</div>
					</div>
				</div>
			</div>
		</header>

		<slot />

		<footer class="bg-gray-100 dark:bg-gray-800 py-12 mt-16">
			<div class="container mx-auto px-4">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
					<div>
						<h3 class="text-lg font-semibold mb-4">产品</h3>
						<ul class="space-y-2">
							<li><a href="/mbti" class={footerLinkClass}>AI与精神分析</a></li>
							<li><a href="/stock" class={footerLinkClass}>股票趋势分析</a></li>
							<li><a href="https://pdf.gantz.host/" class={footerLinkClass}>PDF工具套件</a></li>
						</ul>
					</div>
					<div>
						<h3 class="text-lg font-semibold mb-4">解决方案</h3>
						<ul class="space-y-2">
							<li><a href="#" class={footerLinkClass}>企业数字化转型</a></li>
							<li><a href="#" class={footerLinkClass}>人工智能应用</a></li>
							<li><a href="#" class={footerLinkClass}>数据分析服务</a></li>
						</ul>
					</div>
					<div>
						<h3 class="text-lg font-semibold mb-4">资源</h3>
						<ul class="space-y-2">
							<li><a href="#" class={footerLinkClass}>文档中心</a></li>
							<li><a href="#" class={footerLinkClass}>API参考</a></li>
							<li><a href="#" class={footerLinkClass}>常见问题</a></li>
						</ul>
					</div>
					<div>
						<h3 class="text-lg font-semibold mb-4">公司</h3>
						<ul class="space-y-2">
							<li><a href="/contact" class={footerLinkClass}>联系我们</a></li>
							<li><a href="#" class={footerLinkClass}>关于我们</a></li>
							<li><a href="#" class={footerLinkClass}>加入我们</a></li>
						</ul>
					</div>
				</div>
				<div class="border-t border-gray-200 dark:border-gray-700 pt-8 text-center">
					<div class="flex justify-center items-center mb-4">
						<img src="/images/logo.svg" alt="Logo" class="w-10 h-10 mr-2" />
						<span class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-purple-600">{siteName}</span>
					</div>
					<p class="text-gray-600 dark:text-gray-400">&copy; {new Date().getFullYear()} {siteName} |
						<a href="https://beian.miit.gov.cn/" target="_blank" class={footerLinkClass}>
							桂ICP备2023011846号-1
						</a>
					</p>
					<p class="mt-1 text-xs text-gray-500 dark:text-gray-500">Build: {gitHash}</p>
				</div>
			</div>
		</footer>

		<script>
			// 移动端菜单切换
			document.addEventListener('DOMContentLoaded', () => {
				const mobileMenuButton = document.getElementById('mobile-menu-button');
				const mobileMenu = document.getElementById('mobile-menu');

				if (mobileMenuButton && mobileMenu) {
					mobileMenuButton.addEventListener('click', () => {
						mobileMenu.classList.toggle('hidden');

						// Prevent body scrolling when menu is open
						if (!mobileMenu.classList.contains('hidden')) {
							document.body.style.overflow = 'hidden';
						} else {
							document.body.style.overflow = '';
						}
					});

					// Close menu when clicking outside
					document.addEventListener('click', (e) => {
						if (!mobileMenu.classList.contains('hidden') &&
							!mobileMenu.contains(e.target as Node) &&
							!mobileMenuButton.contains(e.target as Node)) {
							mobileMenu.classList.add('hidden');
							document.body.style.overflow = '';
						}
					});
				}
			});
		</script>
	</body>
</html>
