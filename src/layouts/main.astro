---
interface Props {
	title: string;
	description?: string;
}
import '../styles/global.css';
const siteName = import.meta.env.SITE_NAME;
const { title, description = `${siteName} - 专注于人工智能与科技创新` } = Astro.props;
const gitHash = import.meta.env.PUBLIC_GIT_HASH;
---

<html lang="zh">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title.includes(siteName) ? title : `${title} - ${siteName}`}</title>
	</head>
	<body class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-blue-50 dark:from-gray-900 dark:via-gray-800 dark:to-blue-900">
		<div class="fixed inset-0 -z-10 bg-[radial-gradient(45%_25%_at_50%_50%,rgba(56,189,248,0.05),rgba(255,255,255,0))] dark:bg-[radial-gradient(45%_25%_at_50%_50%,rgba(56,189,248,0.05),rgba(17,24,39,0))]"></div>
		<div class="fixed inset-0 -z-10 bg-[linear-gradient(to_right,#f0f0f0_1px,transparent_1px),linear-gradient(to_bottom,#f0f0f0_1px,transparent_1px)] bg-[size:4rem_4rem] dark:bg-[linear-gradient(to_right,#333333_1px,transparent_1px),linear-gradient(to_bottom,#333333_1px,transparent_1px)]"></div>
		<slot />
		<footer class="py-8 mt-auto">
			<div class="container mx-auto px-4 text-center">
				<div class="flex justify-center space-x-6 mb-4">
					<a href="/" class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">首页</a>
					<a href="/mbti" class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">MBTI分析</a>
					<a href="https://pdf.gantz.host/" target="_blank" class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">PDF工具</a>
					<a href="/contact" class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">联系我们</a>
				</div>
				<div class="text-sm text-gray-500 dark:text-gray-400">
					<p>&copy; {new Date().getFullYear()} {siteName}</p>
					<p class="mt-2">
						<a href="https://beian.miit.gov.cn/" target="_blank" class="hover:text-gray-900 dark:hover:text-white">
							桂ICP备2023011846号-1
						</a>
					</p>
					<p class="mt-1 text-xs text-gray-400">Build: {gitHash}</p>
				</div>
			</div>
		</footer>
	</body>
</html>
